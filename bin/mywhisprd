#!/usr/bin/env python3
"""Launcher: imports the mywhispr package from the sibling directory and runs it."""
from __future__ import annotations

import os
import sys
from pathlib import Path


def _bootstrap() -> None:
    here = Path(__file__).resolve().parent.parent
    pkg_parent = str(here)
    if pkg_parent not in sys.path:
        sys.path.insert(0, pkg_parent)
    if not os.environ.get("MYWHISPR_CONFIG"):
        os.environ["MYWHISPR_CONFIG"] = str(here / "config.json")


_bootstrap()
from mywhispr.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
