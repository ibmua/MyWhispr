#!/usr/bin/env python3
import json
import os
import socket
import subprocess
import sys
import time


ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_PATH = os.path.join(ROOT, "config.json")


def load_config():
    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        return json.load(f)


def connect_socket(path, start_service=True):
    deadline = time.time() + 3.0
    started = False

    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(path)
            return s
        except OSError:
            if s:
                s.close()
            if start_service and not started:
                subprocess.run(
                    ["systemctl", "--user", "start", "my-whisper.service"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                started = True
            if time.time() >= deadline:
                raise
            time.sleep(0.08)


def send(payload):
    cfg = load_config()
    with connect_socket(cfg["socket_path"]) as s:
        s.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
    if not data:
        return {"ok": False, "error": "empty daemon response"}
    return json.loads(data.decode("utf-8"))


def usage():
    print(
        "Usage:\n"
        "  my-whisper-client start <en|uk|auto> <grave|ctrl1>\n"
        "  my-whisper-client stop\n"
        "  my-whisper-client status\n"
        "  my-whisper-client warm\n"
        "  my-whisper-client unload\n"
        "  my-whisper-client shutdown",
        file=sys.stderr,
    )
    return 2


def main(argv):
    if len(argv) < 2:
        return usage()

    cmd = argv[1]
    if cmd == "start":
        if len(argv) != 4:
            return usage()
        payload = {"cmd": "start", "language": argv[2], "trigger": argv[3]}
    elif cmd in {"stop", "status", "warm", "unload", "shutdown"}:
        payload = {"cmd": cmd}
    else:
        return usage()

    try:
        response = send(payload)
    except Exception as e:
        print(f"my-whisper-client: {e}", file=sys.stderr)
        return 1

    print(json.dumps(response, ensure_ascii=False))
    return 0 if response.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
