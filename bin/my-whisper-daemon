#!/usr/bin/env python3
import errno
import fcntl
import html
import http.server
import json
import logging
import math
import os
import selectors
import shutil
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
import uuid
import wave
from datetime import datetime


ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_PATH = os.environ.get("MYWHISPR_CONFIG", os.path.join(ROOT, "config.json"))
EVENT_STRUCT = struct.Struct("llHHI")
EV_KEY = 0x01
KEY_VALUE_RELEASE = 0


def ev_ioctl_name(length):
    return 0x80004506 + (length << 16)


class MyWhisperDaemon:
    def __init__(self):
        self.cfg = self.load_config()
        self.runtime_dir = self.cfg["runtime_dir"]
        self.log_dir = self.cfg["log_dir"]
        os.makedirs(self.runtime_dir, exist_ok=True)
        os.makedirs(self.log_dir, exist_ok=True)

        logging.basicConfig(
            level=logging.INFO,
            format="%(asctime)s %(levelname)s %(message)s",
            handlers=[
                logging.FileHandler(os.path.join(self.log_dir, "my-whisper.log")),
                logging.StreamHandler(sys.stdout),
            ],
        )

        self.lock = threading.RLock()
        self.shutdown_event = threading.Event()
        self.record_proc = None
        self.recording = None
        self.processing = False
        self.last_stop_time = 0.0
        self.server_proc = None
        self.server_started_by_us = False
        self.server_log_path = os.path.join(self.log_dir, "whisper-server.log")
        self.last_server_use = 0.0
        self.history_path = self.cfg.get("history_path", os.path.join(self.log_dir, "history.jsonl"))
        self.httpds = []
        self.cue_paths = self.prepare_audio_cues()

    def load_config(self):
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            return json.load(f)

    def notify(self, title, body=""):
        if not self.cfg.get("notifications_enabled", True):
            return
        if not shutil.which("notify-send"):
            return
        subprocess.run(
            ["notify-send", "-a", self.cfg.get("name", "MyWhisper"), title, body, "-t", "1800"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

    def prepare_audio_cues(self):
        cfg = self.cfg.get("audio_cues", {})
        if not cfg.get("enabled", False):
            return {}

        cue_dir = os.path.join(self.runtime_dir, "cues")
        os.makedirs(cue_dir, exist_ok=True)
        paths = {
            "start": os.path.join(cue_dir, "openwhispr-start.wav"),
            "stop": os.path.join(cue_dir, "openwhispr-stop.wav"),
        }
        self.write_tone_sequence(paths["start"], cfg.get("start_frequencies", []), cfg)
        self.write_tone_sequence(paths["stop"], cfg.get("stop_frequencies", []), cfg)
        return paths

    def write_tone_sequence(self, path, frequencies, cfg):
        sample_rate = int(cfg.get("sample_rate", 44100))
        tone_seconds = float(cfg.get("tone_seconds", 0.09))
        gap_seconds = float(cfg.get("gap_seconds", 0.025))
        attack_seconds = float(cfg.get("attack_seconds", 0.015))
        gain = float(cfg.get("gain", 0.2))
        floor_gain = float(cfg.get("floor_gain", 0.0001))
        samples = []

        for index, frequency in enumerate(frequencies):
            if index:
                samples.extend([0] * int(sample_rate * gap_seconds))
            tone_count = max(1, int(sample_rate * tone_seconds))
            attack_count = max(1, int(sample_rate * attack_seconds))
            for i in range(tone_count):
                t = i / sample_rate
                if i < attack_count:
                    envelope = floor_gain + (gain - floor_gain) * (i / attack_count)
                else:
                    progress = (i - attack_count) / max(1, tone_count - attack_count)
                    envelope = gain * ((floor_gain / gain) ** progress)
                value = math.sin(2.0 * math.pi * float(frequency) * t) * envelope
                samples.append(max(-32767, min(32767, int(value * 32767))))

        with wave.open(path, "wb") as wav:
            wav.setnchannels(1)
            wav.setsampwidth(2)
            wav.setframerate(sample_rate)
            wav.writeframes(struct.pack("<" + "h" * len(samples), *samples))

    def play_cue(self, kind):
        cfg = self.cfg.get("audio_cues", {})
        if not cfg.get("enabled", False):
            return
        path = self.cue_paths.get(kind)
        player = cfg.get("player_command", "pw-play")
        if not path or not shutil.which(player):
            return
        try:
            subprocess.Popen(
                [player, path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        except Exception as e:
            logging.debug("failed to play %s cue: %s", kind, e)

    def run(self):
        threading.Thread(target=self.input_event_loop, name="input-events", daemon=True).start()
        threading.Thread(target=self.maximum_recording_watchdog, name="recording-watchdog", daemon=True).start()
        threading.Thread(target=self.whisper_idle_watchdog, name="whisper-idle-watchdog", daemon=True).start()
        threading.Thread(target=self.web_loop, name="web-ui", daemon=True).start()
        self.socket_loop()

    def web_loop(self):
        web_cfg = self.cfg.get("web", {})
        host = web_cfg.get("host", "127.0.0.1")
        port = int(web_cfg.get("port", 16666))

        class ReusableServer(http.server.ThreadingHTTPServer):
            allow_reuse_address = True
            daemon_threads = True

        handler = self.make_web_handler()
        try:
            httpd = ReusableServer((host, port), handler)
        except OSError:
            logging.exception("failed to start web UI on %s:%s", host, port)
            return
        with self.lock:
            self.httpds.append(httpd)
        logging.info("web UI listening at http://%s:%s", host, port)
        threading.Thread(
            target=httpd.serve_forever,
            kwargs={"poll_interval": 0.25},
            name=f"web-ui-{port}",
            daemon=True,
        ).start()

        while not self.shutdown_event.is_set():
            time.sleep(0.5)

    def make_web_handler(self):
        daemon = self

        class Handler(http.server.BaseHTTPRequestHandler):
            server_version = "MyWhisperHTTP/1.0"

            def log_message(self, fmt, *args):
                logging.debug("web: " + fmt, *args)

            def do_GET(self):
                parsed = urllib.parse.urlparse(self.path)
                if parsed.path in ("/", "/index.html"):
                    self.send_response(200)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(daemon.web_index().encode("utf-8"))
                    return
                if parsed.path == "/api/status":
                    self.send_json(daemon.web_status())
                    return
                if parsed.path == "/api/history":
                    self.send_json({"ok": True, "history": daemon.read_history(5)})
                    return
                if parsed.path == "/api/words":
                    self.send_json({"ok": True, "words": daemon.get_custom_words()})
                    return
                self.send_json({"ok": False, "error": "not found"}, status=404)

            def do_POST(self):
                parsed = urllib.parse.urlparse(self.path)
                payload = self.read_json()
                try:
                    if parsed.path == "/api/copy":
                        text = payload.get("text")
                        if not text and payload.get("id"):
                            text = daemon.history_text_by_id(payload["id"])
                        if not text:
                            self.send_json({"ok": False, "error": "missing text"}, status=400)
                            return
                        self.send_json({"ok": daemon.copy_to_clipboard(text)})
                        return
                    if parsed.path == "/api/words":
                        words = payload.get("words")
                        if words is None:
                            words = payload.get("word", "")
                        result = daemon.add_custom_words(words)
                        self.send_json(result)
                        return
                    if parsed.path == "/api/warm":
                        daemon.ensure_whisper_server()
                        self.send_json({"ok": True, "server": "ready"})
                        return
                    if parsed.path == "/api/unload":
                        daemon.stop_whisper_server()
                        self.send_json({"ok": True, "server": "unloaded"})
                        return
                    if parsed.path == "/api/stop":
                        self.send_json(daemon.stop_recording("web-stop"))
                        return
                    if parsed.path == "/api/reload":
                        daemon.reload_config()
                        self.send_json({"ok": True, "config": "reloaded"})
                        return
                except Exception as e:
                    logging.exception("web request failed")
                    self.send_json({"ok": False, "error": str(e)}, status=500)
                    return
                self.send_json({"ok": False, "error": "not found"}, status=404)

            def read_json(self):
                length = int(self.headers.get("Content-Length") or 0)
                if length <= 0:
                    return {}
                raw = self.rfile.read(length).decode("utf-8", errors="replace")
                return json.loads(raw or "{}")

            def send_json(self, data, status=200):
                body = json.dumps(data, ensure_ascii=False).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

        return Handler

    def web_index(self):
        name = html.escape(self.cfg.get("name", "MyWhisper"))
        return f"""<!doctype html>
<html lang="en">
